{
  "name": "ats-cv",
  "version": "1.0.0",
  "description": "ATS d'un seul fichier : grille de critères éditable, notation des CV et décision automatique (accepté / à revoir / rejeté).",
  "type": "module",
  "bin": {
    "ats-cv": "bin/ats-cv.mjs"
  },
  "files": [
    "index.html",
    "bin/",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/ats-cv.mjs",
    "dev": "node bin/ats-cv.mjs --open",
    "check": "node scripts/check.mjs"
  },
  "keywords": [
    "ats",
    "cv",
    "recrutement",
    "presélection",
    "tri-de-cv",
    "scoring"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.0"
}
